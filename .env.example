# ==========================================
# Portfolio Environment Variables
# ==========================================

# Contact form email settings (Gmail fallback)
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-app-password
EMAIL_TO=your-email@gmail.com

# Phase 1: High-capacity Email & Rate Limiting (Optional / Recommended)
RESEND_API_KEY=re_your_resend_api_key
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Phase 2: Content Scaling & On-Demand ISR Webhook
# Used to authenticate CMS webhooks (e.g. /api/revalidate?secret=...)
REVALIDATION_SECRET=your_custom_revalidation_secret_token

# Headless CMS (Optional: if connecting Sanity, Contentful, or external REST API)
CMS_API_URL=https://your-cms-endpoint.com
CMS_API_KEY=your_cms_api_key

# Optional: Local dev port
PORT=4000
